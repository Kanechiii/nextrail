
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nextrail.local/pathway/v1",
  "title": "Nextrail Learning Pathway",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "career_goal", "weekly_hours",
    "milestones", "generation_mode"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "career_goal": { "type": "string", "minLength": 1 },
    "weekly_hours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 80
    },
    "generation_mode": {
      "enum": ["deterministic", "ai_assisted"]
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order", "skill_id", "resource_ids", "rationale"
        ],
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "skill_id": {
            "type": "string",
            "minLength": 1
          },
          "resource_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}